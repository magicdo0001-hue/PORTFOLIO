{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wenhou-yan-design-portfolio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "yanwenhou.tianyuhan.top",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
